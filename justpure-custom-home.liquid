{% comment %}
  JustPure Homepage - Premium Redesign
  Paste this in: Shopify Admin → Online Store → Themes → Edit code → Sections
  Create new section: custom-home.liquid
  All CSS is inside this file—no extra stylesheets.
{% endcomment %}

<section class="homepage-section" id="homepage-{{ section.id }}">
  {%- comment -%} Preload LCP hero image for faster paint {%- endcomment -%}
  {% if section.settings.hero_image != blank %}
    <link rel="preload" as="image" href="{{ section.settings.hero_image | image_url: width: 1600 }}">
  {% endif %}

  {%- comment -%} Hero Section {%- endcomment -%}
  <div class="homepage-hero">
    {% if section.settings.hero_image != blank %}
      <div class="homepage-hero__bg-image">
        <img
          src="{{ section.settings.hero_image | image_url: width: 1600 }}"
          alt="{{ section.settings.hero_image.alt | escape }}"
          width="1600"
          height="960"
          loading="eager"
          fetchpriority="high"
          class="homepage-hero__bg-img"
        >
      </div>
    {% endif %}
    <div class="homepage-hero__bg"></div>
    <div class="homepage-hero__inner">
      <h1 class="homepage-hero__title">{{ section.settings.hero_title | default: 'Traditionally prepared from desi cow milk' }}</h1>
      <p class="homepage-hero__subtitle">{{ section.settings.hero_subtitle | default: 'Sourced directly from Indian farms, and delivered fresh to your home.' }}</p>
      <div class="homepage-hero__cta">
        <a href="{{ section.settings.hero_cta_link | default: routes.collections_url }}" class="homepage-hero__button">
          {{ section.settings.hero_cta_text | default: 'Shop Now' }}
        </a>
      </div>
    </div>
  </div>

  {%- comment -%} Product Categories Section {%- endcomment -%}
  <div class="homepage-categories">
    <div class="homepage-categories__container">
      <div class="homepage-categories__header">
        <div class="homepage-categories__label">Our Products</div>
        <h2 class="homepage-categories__title">{{ section.settings.categories_heading | default: 'From Indian Farms to Your Kitchen' }}</h2>
        <p class="homepage-categories__subtitle">{{ section.settings.categories_subtitle | default: 'Carefully sourced ingredients and small-batch preparation to preserve purity, nutrition, and taste.' }}</p>
      </div>
      <div class="homepage-categories__grid">
        {%- comment -%} Ghee Category {%- endcomment -%}
        <div class="homepage-category-card">
          {% if section.settings.ghee_image != blank %}
            <div class="homepage-category-card__image-wrapper">
              <img
                src="{{ section.settings.ghee_image | image_url: width: 800 }}"
                alt="{{ section.settings.ghee_image.alt | escape }}"
                width="800"
                height="600"
                loading="lazy"
                class="homepage-category-card__image"
              >
            </div>
          {% endif %}
          <div class="homepage-category-card__content">
            <h3 class="homepage-category-card__title">{{ section.settings.ghee_title | default: 'A2 Desi Cow Ghee' }}</h3>
            <p class="homepage-category-card__description">{{ section.settings.ghee_description | default: 'Experience the rich, traditional flavor of our A2 Desi Ghee. Crafted with care, for your health and culinary delight.' }}</p>
            <a href="{{ section.settings.ghee_link | default: routes.collections_url }}" class="homepage-category-card__link">Shop A2 Ghee →</a>
          </div>
        </div>

        {%- comment -%} Oils Category {%- endcomment -%}
        <div class="homepage-category-card">
          {% if section.settings.oils_image != blank %}
            <div class="homepage-category-card__image-wrapper">
              <img
                src="{{ section.settings.oils_image | image_url: width: 800 }}"
                alt="{{ section.settings.oils_image.alt | escape }}"
                width="800"
                height="600"
                loading="lazy"
                class="homepage-category-card__image"
              >
            </div>
          {% endif %}
          <div class="homepage-category-card__content">
            <h3 class="homepage-category-card__title">{{ section.settings.oils_title | default: 'Premium Cold-Pressed Oils' }}</h3>
            <p class="homepage-category-card__description">{{ section.settings.oils_description | default: 'Naturally extracted oils made for purity, nutrition, and long-term wellness. Virgin coconut and pure mustard, perfect for health, beauty, and cooking.' }}</p>
            <a href="{{ section.settings.oils_link | default: routes.collections_url }}" class="homepage-category-card__link">Shop Oils →</a>
          </div>
        </div>

        {%- comment -%} Spices Category {%- endcomment -%}
        <div class="homepage-category-card">
          {% if section.settings.spices_image != blank %}
            <div class="homepage-category-card__image-wrapper">
              <img
                src="{{ section.settings.spices_image | image_url: width: 800 }}"
                alt="{{ section.settings.spices_image.alt | escape }}"
                width="800"
                height="600"
                loading="lazy"
                class="homepage-category-card__image"
              >
            </div>
          {% endif %}
          <div class="homepage-category-card__content">
            <h3 class="homepage-category-card__title">{{ section.settings.spices_title | default: 'Authentic Flavors' }}</h3>
            <p class="homepage-category-card__description">{{ section.settings.spices_description | default: 'Discover our range of 100% pure, natural spices. From vibrant turmeric to aromatic cumin, elevate every meal.' }}</p>
            <a href="{{ section.settings.spices_link | default: routes.collections_url }}" class="homepage-category-card__link">Shop Spices →</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Moringa Featured Section {%- endcomment -%}
  <div class="homepage-moringa">
    <div class="homepage-moringa__container">
      <div class="homepage-moringa__grid">
        {% if section.settings.moringa_image != blank %}
          <div class="homepage-moringa__image-wrapper">
            <img
              src="{{ section.settings.moringa_image | image_url: width: 1200 }}"
              alt="{{ section.settings.moringa_image.alt | escape }}"
              width="1200"
              height="1500"
              loading="lazy"
              class="homepage-moringa__image"
            >
          </div>
        {% else %}
          <div class="homepage-moringa__image-placeholder"></div>
        {% endif %}
        <div class="homepage-moringa__content">
          <div class="homepage-moringa__label">Natural Goodness</div>
          <h2 class="homepage-moringa__title">{{ section.settings.moringa_heading | default: 'Pure Moringa. Naturally Powerful.' }}</h2>
          <p class="homepage-moringa__description">{{ section.settings.moringa_description | default: 'Our moringa is grown naturally, carefully dried, and minimally processed to retain its nutrients. Clean, plant-based nutrition you can trust, every day.' }}</p>
          {% if section.settings.moringa_cta_link != blank %}
            <a href="{{ section.settings.moringa_cta_link }}" class="homepage-moringa__link">{{ section.settings.moringa_cta_text | default: 'Learn More' }} →</a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Why Just Pure Section {%- endcomment -%}
  <div class="homepage-why">
    <div class="homepage-why__container">
      <div class="homepage-why__header">
        <div class="homepage-why__label">Our Promise to You</div>
        <h2 class="homepage-why__title">{{ section.settings.why_heading | default: 'Why Just Pure India?' }}</h2>
      </div>
      <div class="homepage-why__grid">
        <div class="homepage-why-card">
          <div class="homepage-why-card__icon">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M24 4L6 14V24C6 33.941 12.824 42.824 24 44C35.176 42.824 42 33.941 42 24V14L24 4Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M18 24L22 28L30 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="homepage-why-card__title">{{ section.settings.why1_title | default: 'Premium Quality' }}</h3>
          <p class="homepage-why-card__description">{{ section.settings.why1_description | default: 'At Just Pure India, we focus on one thing — delivering genuinely pure food without shortcuts.' }}</p>
        </div>
        <div class="homepage-why-card">
          <div class="homepage-why-card__icon">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8 20L24 8L40 20V36C40 38.2091 38.2091 40 36 40H12C9.79086 40 8 38.2091 8 36V20Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M18 40V24H30V40" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="homepage-why-card__title">{{ section.settings.why2_title | default: 'Trusted Source' }}</h3>
          <p class="homepage-why-card__description">{{ section.settings.why2_description | default: 'Our A2 Bilona Ghee is made using the traditional hand-churned method from desi cow milk. Our spices and oils are sourced from trusted farms and processed without artificial additives.' }}</p>
        </div>
        <div class="homepage-why-card">
          <div class="homepage-why-card__icon">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M24 44C35.046 44 44 35.046 44 24C44 12.954 35.046 4 24 4C12.954 4 4 12.954 4 24C4 35.046 12.954 44 24 44Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M16 24L22 30L32 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="homepage-why-card__title">{{ section.settings.why3_title | default: 'Healthy Living' }}</h3>
          <p class="homepage-why-card__description">{{ section.settings.why3_description | default: 'We believe in nourishing your body with the goodness of nature, promoting a healthier and happier you.' }}</p>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Process / Farm-to-Home Story Section {%- endcomment -%}
  <div class="homepage-process">
    <div class="homepage-process__container">
      <div class="homepage-process__grid">
        <div class="homepage-process__content">
          <div class="homepage-process__label">From Farm to Home</div>
          <h2 class="homepage-process__title">{{ section.settings.process_heading | default: 'A quick look at how we craft our products' }}</h2>
          <p class="homepage-process__subtitle">{{ section.settings.process_subtitle | default: 'From desi cow milk to traditionally prepared A2 Bilona ghee' }}</p>
          <div class="homepage-process__text">
            {{ section.settings.process_content | default: '<p>Our <a href="/products/a2-desi-cow-bilona-ghee">A2 Bilona Ghee</a> is made using the traditional bilona method, where curd is hand-churned and slow-heated to preserve natural nutrition and aroma. We use milk from desi cows sourced from trusted Indian farms.</p><p>Every step of our process respects traditional methods while ensuring the highest standards of purity and quality.</p>' }}
          </div>
          {% if section.settings.process_cta_link != blank %}
            <a href="{{ section.settings.process_cta_link }}" class="homepage-process__link">{{ section.settings.process_cta_text | default: 'Learn More' }} →</a>
          {% endif %}
        </div>
        {% if section.settings.process_video != blank %}
          <div class="homepage-process__video-wrapper">
            <video
              class="homepage-process__video"
              controls
              playsinline
              preload="metadata"
              {% if section.settings.process_video_poster != blank %}poster="{{ section.settings.process_video_poster | image_url: width: 1200 }}"{% endif %}
            >
              <source src="{{ section.settings.process_video }}" type="video/mp4">
              <source src="{{ section.settings.process_video }}" type="video/webm">
              Your browser does not support the video tag.
            </video>
          </div>
        {% else %}
          <div class="homepage-process__video-placeholder"></div>
        {% endif %}
      </div>
    </div>
  </div>

  {%- comment -%} Trust Signals Section {%- endcomment -%}
  <div class="homepage-trust">
    <div class="homepage-trust__container">
      <div class="homepage-trust__header">
        <div class="homepage-trust__label">The Goodness You Can Trust</div>
        <h2 class="homepage-trust__title">{{ section.settings.trust_heading | default: 'Nourishing You, Naturally' }}</h2>
        <p class="homepage-trust__subtitle">{{ section.settings.trust_subtitle | default: 'Just Pure India is committed to bringing you the purest, most wholesome products, naturally.' }}</p>
      </div>
      <div class="homepage-trust__grid">
        <div class="homepage-trust-item">
          <div class="homepage-trust-item__icon">✓</div>
          <h3 class="homepage-trust-item__title">100% Natural & Preservative Free</h3>
        </div>
        <div class="homepage-trust-item">
          <div class="homepage-trust-item__icon">✓</div>
          <h3 class="homepage-trust-item__title">Sustainably Sourced</h3>
        </div>
        <div class="homepage-trust-item">
          <div class="homepage-trust-item__icon">✓</div>
          <h3 class="homepage-trust-item__title">No Artificial Additives</h3>
        </div>
        <div class="homepage-trust-item">
          <div class="homepage-trust-item__icon">✓</div>
          <h3 class="homepage-trust-item__title">Delivered Fresh to Your Doorstep</h3>
        </div>
      </div>
      <div class="homepage-trust__badges">
        <div class="homepage-trust-badge">
          <div class="homepage-trust-badge__label">NABARD Backed</div>
          <div class="homepage-trust-badge__description">FPO since 2016</div>
        </div>
        <div class="homepage-trust-badge">
          <div class="homepage-trust-badge__label">1500+</div>
          <div class="homepage-trust-badge__description">Dairy Farmers</div>
        </div>
        <div class="homepage-trust-badge">
          <div class="homepage-trust-badge__label">3x</div>
          <div class="homepage-trust-badge__description">Best FPO Award</div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Final CTA Section {%- endcomment -%}
  <div class="homepage-cta">
    <div class="homepage-cta__container">
      <div class="homepage-cta__inner">
        <h2 class="homepage-cta__title">{{ section.settings.cta_heading | default: 'Ready to Experience the Difference?' }}</h2>
        <p class="homepage-cta__subtitle">{{ section.settings.cta_subtitle | default: 'Explore our range of natural products. Discover the taste of purity and goodness. Start your healthy living journey today.' }}</p>
        <div class="homepage-cta__buttons">
          <a href="{{ section.settings.cta_primary_link | default: routes.collections_url }}" class="homepage-cta__button homepage-cta__button--primary">
            {{ section.settings.cta_primary_text | default: 'Shop Now' }}
          </a>
          {% if section.settings.cta_secondary_link != blank %}
            <a href="{{ section.settings.cta_secondary_link }}" class="homepage-cta__button homepage-cta__button--secondary">
              {{ section.settings.cta_secondary_text | default: 'Learn More' }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

</section>

<style>
  {% comment %} Fonts loaded via snippets/fonts-preconnect.liquid in theme.liquid (non-blocking). {% endcomment %}
  #homepage-{{ section.id }} {
    font-family: 'DM Sans', var(--font-body-family), system-ui, -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    color: #1a1a1a;
    overflow-x: hidden;
  }

  /* ——— Hero Section ——— */
  #homepage-{{ section.id }} .homepage-hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #0f2410 0%, #1a3a1c 25%, #2d5016 50%, #3d6b1a 75%, #4a7c23 100%);
    color: #ffffff;
    padding: 120px 48px;
    overflow: hidden;
  }
  @media (max-width: 768px) {
    #homepage-{{ section.id }} .homepage-hero {
      min-height: 75vh;
      padding: 80px 24px;
    }
  }
  #homepage-{{ section.id }} .homepage-hero__bg-image {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
  }
  #homepage-{{ section.id }} .homepage-hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.2;
  }
  #homepage-{{ section.id }} .homepage-hero__bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 30% 50%, rgba(255,255,255,0.05) 0%, transparent 50%),
                radial-gradient(circle at 70% 80%, rgba(255,255,255,0.03) 0%, transparent 50%);
    z-index: 1;
  }
  #homepage-{{ section.id }} .homepage-hero__inner {
    position: relative;
    z-index: 2;
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }
  #homepage-{{ section.id }} .homepage-hero__badge {
    display: inline-block;
    padding: 10px 24px;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50px;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    margin-bottom: 32px;
    color: rgba(255, 255, 255, 0.95);
  }
  #homepage-{{ section.id }} .homepage-hero__title {
    font-family: "Playfair Display", serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 24px;
    color: #ffffff;
  }
  #homepage-{{ section.id }} .homepage-hero__subtitle {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    line-height: 1.7;
    max-width: 700px;
    margin: 0 auto 48px;
    color: rgba(255, 255, 255, 0.9);
    font-weight: 400;
  }
  #homepage-{{ section.id }} .homepage-hero__cta {
    margin-top: 40px;
  }
  #homepage-{{ section.id }} .homepage-hero__button {
    display: inline-block;
    padding: 18px 48px;
    background: #ffffff;
    color: #2d5016;
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 50px;
    transition: all 0.3s ease;
    letter-spacing: 0.02em;
  }
  #homepage-{{ section.id }} .homepage-hero__button:hover {
    background: rgba(255, 255, 255, 0.95);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  }

  /* ——— Product Categories Section ——— */
  #homepage-{{ section.id }} .homepage-categories {
    padding: 140px 0;
    background: #ffffff;
  }
  @media (max-width: 768px) {
    #homepage-{{ section.id }} .homepage-categories {
      padding: 100px 0;
    }
  }
  #homepage-{{ section.id }} .homepage-categories__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 48px;
  }
  @media (max-width: 768px) {
    #homepage-{{ section.id }} .homepage-categories__container {
      padding: 0 24px;
    }
  }
  #homepage-{{ section.id }} .homepage-categories__header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 80px;
  }
  @media (max-width: 768px) {
    #homepage-{{ section.id }} .homepage-categories__header {
      margin-bottom: 60px;
    }
  }
  #homepage-{{ section.id }} .homepage-categories__label {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #2d5016;
    margin-bottom: 16px;
  }
  #homepage-{{ section.id }} .homepage-categories__title {
    font-family: "Playfair Display", serif;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 20px;
    color: #1a1a1a;
  }
  #homepage-{{ section.id }} .homepage-categories__subtitle {
    font-size: 1.15rem;
    line-height: 1.8;
    color: #4a4a4a;
    margin: 0;
  }
  #homepage-{{ section.id }} .homepage-categories__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
  }
  @media (max-width: 1024px) {
    #homepage-{{ section.id }} .homepage-categories__grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }
  #homepage-{{ section.id }} .homepage-category-card {
    display: flex;
    flex-direction: column;
    background: #faf8f5;
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  #homepage-{{ section.id }} .homepage-category-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
  }
  #homepage-{{ section.id }} .homepage-category-card__image-wrapper {
    width: 100%;
    padding-top: 75%;
    position: relative;
    overflow: hidden;
    background: #f5f2ed;
  }
  #homepage-{{ section.id }} .homepage-category-card__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #homepage-{{ section.id }} .homepage-category-card__content {
    padding: 40px 32px;
  }
  @media (max-width: 768px) {
    #homepage-{{ section.id }} .homepage-category-card__content {
      padding: 32px 24px;
    }
  }
  #homepage-{{ section.id }} .homepage-category-card__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 16px;
    color: #1a1a1a;
  }
  #homepage-{{ section.id }} .homepage-category-card__description {
    font-size: 1rem;
    line-height: 1.75;
    color: #4a4a4a;
    margin: 0 0 24px;
  }
  #homepage-{{ section.id }} .homepage-category-card__link {
    display: inline-block;
    font-size: 1rem;
    font-weight: 600;
    color: #2d5016;
    text-decoration: none;
    transition: color 0.3s ease;
  }
  #homepage-{{ section.id }} .homepage-category-card__link:hover {
    color: #3d6b1a;
  }

  /* ——— Moringa Featured Section ——— */
  #homepage-{{ section.id }} .homepage-moringa {
    padding: 140px 0;
    background: #faf8f5;
  }
  @media (max-width: 768px) {
    #homepage-{{ section.id }} .homepage-moringa {
      padding: 100px 0;
    }
  }
  #homepage-{{ section.id }} .homepage-moringa__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 48px;
  }
  @media (max-width: 768px) {
    #homepage-{{ section.id }} .homepage-moringa__container {
      padding: 0 24px;
    }
  }
  #homepage-{{ section.id }} .homepage-moringa__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  @media (max-width: 1024px) {
    #homepage-{{ section.id }} .homepage-moringa__grid {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }
  #homepage-{{ section.id }} .homepage-moringa__image-wrapper {
    position: relative;
    width: 100%;
    padding-top: 125%;
    overflow: hidden;
