    font-size: 1.1rem;
    line-height: 1.7;
    margin: 0;
    color: #555555;
    max-width: 280px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ——— Business Model ——— */
  #about-us-{{ section.id }} .about-us-business {
    padding: 140px 0;
