    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
  }
  @media (max-width: 992px) {
    #about-us-{{ section.id }} .about-us-milestones__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    #about-us-{{ section.id }} .about-us-milestones__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  #about-us-{{ section.id }} .about-us-milestone-card {
    padding: 40px 36px;
    background: #ffffff;
    border-top: 2px solid #2d5016;
    transition: box-shadow 0.3s ease;
  }
  #about-us-{{ section.id }} .about-us-milestone-card:hover {
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
  }
  #about-us-{{ section.id }} .about-us-milestone-card__year {
    display: block;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: #2d5016;
    letter-spacing: 0.05em;
    margin-bottom: 16px;
    text-transform: uppercase;
  }
  #about-us-{{ section.id }} .about-us-milestone-card p {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.8;
    color: #3a3a3a;
  }
  #about-us-{{ section.id }} .about-us-milestone-card strong {
    color: #2d5016;
    font-weight: 600;
  }

  /* ——— Closing CTA ——— */
  #about-us-{{ section.id }} .about-us-cta {
    background: linear-gradient(160deg, #1a2e0a 0%, #2d5016 40%, #3d6b1a 100%);
    color: #ffffff;
    padding: 140px 48px 120px;
    text-align: center;
  }
  @media (max-width: 768px) {
    #about-us-{{ section.id }} .about-us-cta {
      padding: 100px 24px 80px;
    }
  }
  #about-us-{{ section.id }} .about-us-cta__inner {
    max-width: 800px;
    margin: 0 auto;
  }
  #about-us-{{ section.id }} .about-us-cta__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 28px;
    color: #ffffff;
  }
  #about-us-{{ section.id }} .about-us-cta__text {
    font-size: clamp(1.15rem, 1.8vw, 1.3rem);
    line-height: 1.85;
    margin: 0 0 40px;
