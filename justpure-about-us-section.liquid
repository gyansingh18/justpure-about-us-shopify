  }
  @media (max-width: 768px) {
    #about-us-{{ section.id }} .about-us-values__container {
      padding: 0 24px;
    }
  }
  #about-us-{{ section.id }} .about-us-values__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px;
    max-width: 1200px;
    margin: 0 auto;
  }
  @media (max-width: 768px) {
    #about-us-{{ section.id }} .about-us-values__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  #about-us-{{ section.id }} .about-us-value-card {
    text-align: center;
    padding: 56px 40px;
    border-top: 2px solid #2d5016;
    transition: transform 0.3s ease;
  }
  #about-us-{{ section.id }} .about-us-value-card:hover {
    transform: translateY(-4px);
  }
  #about-us-{{ section.id }} .about-us-value-card__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
