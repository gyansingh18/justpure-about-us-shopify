      gap: 40px;
    }
  }
  @media (max-width: 768px) {
    #about-us-{{ section.id }} .about-us-business__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
  #about-us-{{ section.id }} .about-us-business-card {
    padding: 0;
    background: transparent;
    border-left: 3px solid #2d5016;
    padding-left: 32px;
  }
  #about-us-{{ section.id }} .about-us-business-card__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.6rem, 2vw, 2rem);
    font-weight: 600;
    margin: 0 0 20px;
    color: #2d5016;
  }
  #about-us-{{ section.id }} .about-us-business-card__text {
    font-size: 1.1rem;
    line-height: 1.85;
    margin: 0;
    color: #3a3a3a;
    max-width: 90%;
  }

  /* ——— Vision & Promise ——— */
  #about-us-{{ section.id }} .about-us-vision-promise {
    padding: 140px 0;
    background: #ffffff;
  }
  @media (max-width: 768px) {
    #about-us-{{ section.id }} .about-us-vision-promise {
      padding: 100px 0;
    }
  }
  #about-us-{{ section.id }} .about-us-vision-promise__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 48px;
  }
  @media (max-width: 768px) {
    #about-us-{{ section.id }} .about-us-vision-promise__container {
      padding: 0 24px;
    }
  }
  #about-us-{{ section.id }} .about-us-vision-promise__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
    max-width: 1200px;
    margin: 0 auto;
  }
  @media (max-width: 768px) {
    #about-us-{{ section.id }} .about-us-vision-promise__grid {
      grid-template-columns: 1fr;
      gap: 64px;
    }
  }
  #about-us-{{ section.id }} .about-us-vision-list,
  #about-us-{{ section.id }} .about-us-promise-list {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1.15rem;
    line-height: 2.1;
    color: #3a3a3a;
  }
  #about-us-{{ section.id }} .about-us-vision-list li,
  #about-us-{{ section.id }} .about-us-promise-list li {
    position: relative;
    padding-left: 28px;
    margin-bottom: 16px;
  }
  #about-us-{{ section.id }} .about-us-vision-list li::before,
  #about-us-{{ section.id }} .about-us-promise-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.85em;
    width: 8px;
    height: 8px;
    background: #2d5016;
    border-radius: 50%;
  }

  /* ——— Achievements & Strengths ——— */
