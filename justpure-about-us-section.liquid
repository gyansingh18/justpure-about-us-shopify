{% comment %}
  JustPure About Us Section - World-Class Premium Design
  Paste this in: Shopify Admin → Online Store → Themes → Edit code → Sections
  Create new section: about-us.liquid
  All CSS is inside this file—no extra stylesheets.
{% endcomment %}

<section class="about-us-section" id="about-us-{{ section.id }}">
  {%- comment -%} Hero Section {%- endcomment -%}
  <div class="about-us-hero">
    {% if section.settings.hero_image != blank %}
      <div class="about-us-hero__bg-image">
        <img
          src="{{ section.settings.hero_image | image_url: width: 1600 }}"
          alt="{{ section.settings.hero_image.alt | escape }}"
          width="1600"
          height="960"
          loading="eager"
          fetchpriority="high"
          class="about-us-hero__bg-img"
        >
      </div>
    {% endif %}
    <div class="about-us-hero__bg"></div>
    <div class="about-us-hero__inner">
      <div class="about-us-hero__badge">Since 2016</div>
      <h1 class="about-us-hero__title">{{ section.settings.hero_title | default: 'Who Are We' }}</h1>
      <p class="about-us-hero__subtitle">Healthy Choice. Wealthy Life.</p>
      <div class="about-us-hero__content">
        {{ section.settings.hero_description | default: "JUST PURE, backed by Shakti Vardhak Milk Producer Co. Ltd, brings farm-fresh dairy and natural products to the world while uplifting small farmers through better market access and sustainable practices." }}
      </div>
    </div>
  </div>

  {%- comment -%} Stats Section {%- endcomment -%}
  <div class="about-us-stats">
    <div class="about-us-stats__container">
      <div class="about-us-stats__grid">
        <div class="about-us-stat-card">
          <div class="about-us-stat-card__number">1500+</div>
          <div class="about-us-stat-card__label">Dairy Farmers</div>
        </div>
        <div class="about-us-stat-card">
          <div class="about-us-stat-card__number">2016</div>
          <div class="about-us-stat-card__label">Established</div>
        </div>
        <div class="about-us-stat-card">
          <div class="about-us-stat-card__number">3x</div>
          <div class="about-us-stat-card__label">Best FPO Award</div>
        </div>
        <div class="about-us-stat-card">
          <div class="about-us-stat-card__number">20K</div>
          <div class="about-us-stat-card__label">Litres Daily</div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Story Section {%- endcomment -%}
  <div class="about-us-story">
    <div class="about-us-story__container">
      <div class="about-us-story__grid">
        <div class="about-us-story__content">
          <div class="about-us-story__label">Our Story</div>
          <h2 class="about-us-story__title">Rooted in Tradition, Growing with Innovation</h2>
          <div class="about-us-story__text">
            <p>JUST PURE is brand name owned by Shakti Vardhak Milk Producer Company Ltd set up in <strong>2016</strong> under aegis of <strong>NABARD</strong>. Shakti Vardhak is one of the established FPCs in Haryana with more than <strong>1500 dairy farmers</strong> being its active members.</p>
            <p>M/s Shakti Vardhak Milk Producer Co. Ltd and M/s Krishak Support Pvt Ltd are owned by our FPO Members and are coming in with their new product line for export and ecommerce under the name Just Pure. <a href="{{ routes.collections_url }}">Our range of pure Indian foods</a> includes <a href="/products/a2-desi-cow-bilona-ghee">our A2 Bilona Ghee</a>, milk and dairy products, dehydrated vegetables and much more.</p>
            <p>The Company was incorporated in order to deal with the challenges of small milk farmers with a vision to dedicatedly support them to get better market linkage and uplift their livelihoods. We give special attention in educating our farmers about Good Animal Husbandry Practices and advanced animal health requirements and aware them about nutrition management practices, which are the key elements of animal productivity.</p>
            <p>We have been awarded thrice as <strong>"The BEST FPO"</strong> in Haryana under the guidance of <strong>NABARD</strong>. Our team is also part of the regional advisory group of NABARD.</p>
          </div>
        </div>
        {% if section.settings.story_image != blank %}
          <div class="about-us-story__image-wrapper">
            <img
              src="{{ section.settings.story_image | image_url: width: 1200 }}"
              alt="{{ section.settings.story_image.alt | escape }}"
              width="1200"
              height="1500"
              loading="lazy"
              class="about-us-story__image"
            >
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {%- comment -%} Why Just Pure {%- endcomment -%}
  <div class="about-us-values">
    <div class="about-us-values__container">
      <div class="about-us-values__header">
        <div class="about-us-values__label">Why Choose Us</div>
        <h2 class="about-us-values__title">{{ section.settings.values_heading | default: 'Why Just Pure?' }}</h2>
      </div>
      <div class="about-us-values__grid">
        <div class="about-us-value-card">
          {% if section.settings.value1_image != blank %}
            <div class="about-us-value-card__image-wrapper">
              <img
                src="{{ section.settings.value1_image | image_url: width: 500 }}"
                alt="{{ section.settings.value1_image.alt | escape }}"
                width="500"
                height="400"
                loading="lazy"
                class="about-us-value-card__image"
              >
            </div>
          {% else %}
            <div class="about-us-value-card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
              </svg>
            </div>
          {% endif %}
          <h3 class="about-us-value-card__title">{{ section.settings.value1_title | default: 'Authentic' }}</h3>
          <p class="about-us-value-card__desc">{{ section.settings.value1_desc | default: 'Fresh, natural and totally safe products' }}</p>
        </div>
        <div class="about-us-value-card">
          {% if section.settings.value2_image != blank %}
            <div class="about-us-value-card__image-wrapper">
              <img
                src="{{ section.settings.value2_image | image_url: width: 500 }}"
                alt="{{ section.settings.value2_image.alt | escape }}"
                width="500"
                height="400"
                loading="lazy"
                class="about-us-value-card__image"
              >
            </div>
          {% else %}
            <div class="about-us-value-card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
              </svg>
            </div>
          {% endif %}
          <h3 class="about-us-value-card__title">{{ section.settings.value2_title | default: '100% Quality' }}</h3>
          <p class="about-us-value-card__desc">{{ section.settings.value2_desc | default: 'Top-grade natural and hygienic products' }}</p>
        </div>
        <div class="about-us-value-card">
          {% if section.settings.value3_image != blank %}
            <div class="about-us-value-card__image-wrapper">
              <img
                src="{{ section.settings.value3_image | image_url: width: 500 }}"
                alt="{{ section.settings.value3_image.alt | escape }}"
                width="500"
                height="400"
                loading="lazy"
                class="about-us-value-card__image"
              >
            </div>
          {% else %}
            <div class="about-us-value-card__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <text x="12" y="17" text-anchor="middle" font-size="16" font-weight="700" fill="currentColor" stroke="none" style="font-family: system-ui, -apple-system, sans-serif;">₹</text>
              </svg>
            </div>
          {% endif %}
          <h3 class="about-us-value-card__title">{{ section.settings.value3_title | default: 'Pocket Friendly' }}</h3>
          <p class="about-us-value-card__desc">{{ section.settings.value3_desc | default: 'Extensive range at economical prices selling.' }}</p>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Business Model {%- endcomment -%}
  <div class="about-us-business">
    <div class="about-us-business__container">
      <div class="about-us-business__header">
        <div class="about-us-business__label">How We Work</div>
        <h2 class="about-us-business__title">{{ section.settings.business_heading | default: 'Our Business Model' }}</h2>
      </div>
      <div class="about-us-business__grid">
        <div class="about-us-business-card">
          {% if section.settings.bm1_image != blank %}
            <div class="about-us-business-card__image-wrapper">
              <img
                src="{{ section.settings.bm1_image | image_url: width: 600 }}"
                alt="{{ section.settings.bm1_image.alt | escape }}"
                width="600"
                height="400"
                loading="lazy"
                class="about-us-business-card__image"
              >
            </div>
          {% endif %}
          <div class="about-us-business-card__content">
            <div class="about-us-business-card__number">01</div>
            <h3 class="about-us-business-card__title">{{ section.settings.bm1_title | default: 'Production Side' }}</h3>
            <p class="about-us-business-card__text">{{ section.settings.bm1_text | default: "Our FPO has developed a robust 'Package of Practices' for management of cattle breeds that are mainly reared in the local region in partnership with the State Animal Husbandry Department. Our prime focus is on delivering the necessary information on animal health, nutrition, and hygiene management practices to our farmers in the most understandable language." }}</p>
          </div>
        </div>
        <div class="about-us-business-card">
          {% if section.settings.bm2_image != blank %}
            <div class="about-us-business-card__image-wrapper">
              <img
                src="{{ section.settings.bm2_image | image_url: width: 600 }}"
                alt="{{ section.settings.bm2_image.alt | escape }}"
                width="600"
                height="400"
                loading="lazy"
                class="about-us-business-card__image"
              >
            </div>
          {% endif %}
          <div class="about-us-business-card__content">
            <div class="about-us-business-card__number">02</div>
            <h3 class="about-us-business-card__title">{{ section.settings.bm2_title | default: 'Milk Collections' }}</h3>
            <p class="about-us-business-card__text">{{ section.settings.bm2_text | default: "We follow an aggregator-based collection model, in which milk is collected from farmer's doorstep by the aggregator and payment is made in exchange of milk. The collected milk is then brought to our collection centre where its quality is thoroughly ensured for the further processes." }}</p>
          </div>
        </div>
        <div class="about-us-business-card">
          {% if section.settings.bm3_image != blank %}
            <div class="about-us-business-card__image-wrapper">
              <img
                src="{{ section.settings.bm3_image | image_url: width: 600 }}"
                alt="{{ section.settings.bm3_image.alt | escape }}"
                width="600"
                height="400"
                loading="lazy"
                class="about-us-business-card__image"
              >
            </div>
          {% endif %}
          <div class="about-us-business-card__content">
            <div class="about-us-business-card__number">03</div>
            <h3 class="about-us-business-card__title">{{ section.settings.bm3_title | default: 'Processing Side' }}</h3>
            <p class="about-us-business-card__text">{{ section.settings.bm3_text | default: "This area of our business model deals with the processing of the milk and milk products. The collected milk comes to our company's plant where it is pasteurized and packaged under our brand 'Shakti Vardhak'. We have our own plant which handles up to 20,000 litres of milk everyday for processing milk and milk products such as paneer, curd and ghee." }}</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Additional Info {%- endcomment -%}
  <div class="about-us-additional">
    <div class="about-us-additional__container">
      <div class="about-us-additional__grid">
        <div class="about-us-additional__content">
          <p>JUST PURE a brand name of Shakti Vardhak Milk Producer Co. Ltd is a Farmer Producer Organization set up in 2016 duly promoted by NABARD. Our FPO has been awarded as "The BEST FPO" in Haryana for three times within the short period of time. Our organization associates with more than 1500 farmer members who have their own cattle.</p>
          <p>We collect fresh milk from Kankrej cows and buffaloes through our aggregator system, partnering with farmers for door-to-door pickup. Each batch undergoes a rigorous quality check by our team to ensure purity and freshness before processing. This ensures that only the best-quality milk is used for making our desi ghee and other dairy products.</p>
          <p>Our farmer members actively participate and support each other as a family, and all farmers are within our reach. Our farmers give a great deal of care while producing fresh, healthy, hygienic as well as good quality of A2 Cow Milk and responsibly supplying it to the FPO.</p>
          <p>In order to serve utmost satisfaction to our customers, we keep up with hygienic processing, safe packaging, global standards and reasonable cost.</p>
        </div>
        {% if section.settings.additional_image != blank %}
          <div class="about-us-additional__image-wrapper">
            <img
              src="{{ section.settings.additional_image | image_url: width: 800 }}"
              alt="{{ section.settings.additional_image.alt | escape }}"
              width="800"
              height="1000"
              loading="lazy"
              class="about-us-additional__image"
            >
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {%- comment -%} Vision & Promise {%- endcomment -%}
  <div class="about-us-vision-promise">
    <div class="about-us-vision-promise__container">
      <div class="about-us-vision-promise__grid">
        <div class="about-us-vision-block">
          <h2 class="about-us-vision-block__title">{{ section.settings.vision_heading | default: 'Our Vision' }}</h2>
          <ul class="about-us-vision-list">
            <li><span>To empower and uplift livelihoods of small farmers.</span></li>
            <li><span>To conserve native cattle breeds.</span></li>
            <li><span>To serve the society and generate employment as far as the rural areas.</span></li>
            <li><span>To re-establish the awareness about our rich Ayurvedic heritage</span></li>
          </ul>
        </div>
        <div class="about-us-promise-block">
          <h2 class="about-us-promise-block__title">{{ section.settings.promise_heading | default: 'Our Promise' }}</h2>
          <ul class="about-us-promise-list">
            <li><span>Fresh, hygienic and chemical-free products.</span></li>
            <li><span>Extensive variety.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Achievements {%- endcomment -%}
  <div class="about-us-milestones">
    <div class="about-us-milestones__container">
      <div class="about-us-milestones__header">
        <div class="about-us-milestones__label">Recognition</div>
        <h2 class="about-us-milestones__title">{{ section.settings.milestones_heading | default: 'Our Achievements & Strengths' }}</h2>
      </div>
      <div class="about-us-milestones__grid">
        <div class="about-us-milestone-card">
          <div class="about-us-milestone-card__year">2017–18, 2018–19</div>
          <p>We were awarded with "Sarvoch Sahbhagita Puruskar" by NABARD consecutively in 2017-18 and 2018-19.</p>
        </div>
        <div class="about-us-milestone-card">
          <div class="about-us-milestone-card__year">2017–18</div>
          <p>In 2017-18, we became the first FPO to sign a Memorandum of Understanding (MoU) with Lala Lajpat Rai University of Veterinary and Animal Sciences for farmers training and capability building of company's workforce in their state-of-the-art laboratory.</p>
        </div>
        <div class="about-us-milestone-card">
          <div class="about-us-milestone-card__year">2017–18</div>
          <p>Awarded as <strong>The BEST FPO</strong> in Agriculture Leadership Summit in 2017-18.</p>
        </div>
        <div class="about-us-milestone-card">
          <div class="about-us-milestone-card__year"></div>
          <p>We were selected to be a member of Regional Advisory Committee of NABARD in MCID and FSDD.</p>
        </div>
        <div class="about-us-milestone-card">
          <div class="about-us-milestone-card__year"></div>
          <p>We were appointed as CBBO (Cluster Based Business Organization) by SFAC India (An Organization of Ministry of Agriculture India) and SFAC India has assigned to form 25 New FPO in Haryana and Punjab under the scheme of 10000 New FPO of Govt of India.</p>
        </div>
        <div class="about-us-milestone-card">
          <div class="about-us-milestone-card__year"></div>
          <p>Our USP includes modern technology and old traditional methods to keep the highest quality and purity</p>
        </div>
        <div class="about-us-milestone-card">
          <div class="about-us-milestone-card__year"></div>
          <p>We are actively involved in Krishi Mela which is organized regularly for direct outreach to consumers.</p>
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} CTA {%- endcomment -%}
  <div class="about-us-cta">
    <div class="about-us-cta__bg"></div>
    <div class="about-us-cta__inner">
      <h2 class="about-us-cta__title">{{ section.settings.cta_heading | default: 'Experience Purity, Taste the Difference' }}</h2>
      <p class="about-us-cta__text">{{ section.settings.cta_text | default: 'Discover farm-fresh dairy and natural products crafted with care. Support sustainable farming and enjoy the purest quality with JUST PURE.' }}</p>
      {% if section.settings.cta_button_label != blank and section.settings.cta_button_link != blank %}
        <a href="{{ section.settings.cta_button_link }}" class="about-us-cta__button">
          <span>{{ section.settings.cta_button_label }}</span>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {% else %}
        <a href="{{ routes.root_url }}collections/all" class="about-us-cta__button">
          <span>Shop Now</span>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  {% comment %} Fonts loaded via snippets/fonts-preconnect.liquid in theme.liquid (non-blocking). {% endcomment %}
  #about-us-{{ section.id }} {
    font-family: 'DM Sans', var(--font-body-family), system-ui, -apple-system, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    color: #1a1a1a;
    overflow-x: hidden;
  }

  /* ——— Hero Section ——— */
  #about-us-{{ section.id }} .about-us-hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #0f2410 0%, #1a3a1c 25%, #2d5016 50%, #3d6b1a 75%, #4a7c23 100%);
    color: #ffffff;
    padding: 120px 48px;
    overflow: hidden;
  }
  @media (max-width: 768px) {
    #about-us-{{ section.id }} .about-us-hero {
      min-height: 80vh;
      padding: 80px 24px;
    }
  }
  #about-us-{{ section.id }} .about-us-hero__bg-image {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
  }
  #about-us-{{ section.id }} .about-us-hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.25;
  }
  #about-us-{{ section.id }} .about-us-hero__bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 30% 50%, rgba(255,255,255,0.05) 0%, transparent 50%),
                radial-gradient(circle at 70% 80%, rgba(255,255,255,0.03) 0%, transparent 50%);
    animation: pulse 8s ease-in-out infinite;
    z-index: 1;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }
  #about-us-{{ section.id }} .about-us-hero__inner {
    position: relative;
    z-index: 2;
    max-width: 1000px;
    margin: 0 auto;
    text-align: center;
  }
  #about-us-{{ section.id }} .about-us-hero__badge {
    display: inline-block;
    padding: 8px 20px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 32px;
    animation: fadeInUp 0.8s ease-out;
  }
  #about-us-{{ section.id }} .about-us-hero__title {
    font-family: "Playfair Display", serif;
    font-size: clamp(3.5rem, 9vw, 6.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 20px;
    color: #ffffff;
    animation: fadeInUp 0.8s ease-out 0.2s both;
  }
  #about-us-{{ section.id }} .about-us-hero__subtitle {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 400;
    font-style: italic;
    letter-spacing: 0.05em;
    margin: 0 0 40px;
    color: rgba(255, 255, 255, 0.9);
    animation: fadeInUp 0.8s ease-out 0.4s both;
  }
  #about-us-{{ section.id }} .about-us-hero__content {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.85;
    max-width: 800px;
    margin: 0 auto;
    color: rgba(255, 255, 255, 0.95);
    animation: fadeInUp 0.8s ease-out 0.6s both;
  }
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ——— Stats Section ——— */
  #about-us-{{ section.id }} .about-us-stats {
    padding: 80px 0;
    background: #ffffff;
    margin-top: -60px;
    position: relative;
    z-index: 2;
  }
  @media (max-width: 768px) {
    #about-us-{{ section.id }} .about-us-stats {
      padding: 60px 0;
      margin-top: -40px;
    }
  }
  #about-us-{{ section.id }} .about-us-stats__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 48px;
  }
  @media (max-width: 768px) {
    #about-us-{{ section.id }} .about-us-stats__container {
      padding: 0 24px;
    }
  }
  #about-us-{{ section.id }} .about-us-stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  @media (max-width: 768px) {
    #about-us-{{ section.id }} .about-us-stats__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }
  #about-us-{{ section.id }} .about-us-stat-card {
    text-align: center;
    padding: 48px 32px;
    background: linear-gradient(135deg, #f8f9f5 0%, #ffffff 100%);
    border-radius: 20px;
    border: 1px solid rgba(45, 80, 22, 0.1);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
