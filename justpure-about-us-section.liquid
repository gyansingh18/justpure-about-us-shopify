      gap: 60px;
    }
  }
  @media (max-width: 768px) {
    #about-us-{{ section.id }} .about-us-story__grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    #about-us-{{ section.id }} .about-us-story__image-wrapper {
      order: -1;
    }
  }
  #about-us-{{ section.id }} .about-us-story__content {
    max-width: 65ch;
  }
  #about-us-{{ section.id }} .about-us-story__text {
    font-size: 1.15rem;
    line-height: 1.9;
    color: #3a3a3a;
  }
  #about-us-{{ section.id }} .about-us-story__text p {
    margin: 0 0 24px;
  }
  #about-us-{{ section.id }} .about-us-story__text p:last-child {
    margin-bottom: 0;
  }
  #about-us-{{ section.id }} .about-us-story__text strong {
    color: #2d5016;
    font-weight: 600;
  }
  #about-us-{{ section.id }} .about-us-story__image-wrapper {
    position: relative;
  }
  #about-us-{{ section.id }} .about-us-story__image {
    width: 100%;
    height: auto;
    border-radius: 4px;
    object-fit: cover;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
  }
  #about-us-{{ section.id }} .about-us-story__spacer {
    min-height: 400px;
  }

  /* ——— Headings ——— */
  #about-us-{{ section.id }} .about-us__heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 40px;
    color: #1a1a1a;
  }
  #about-us-{{ section.id }} .about-us__heading--center {
    text-align: center;
    margin-bottom: 64px;
  }
  @media (max-width: 768px) {
