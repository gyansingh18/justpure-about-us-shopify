    #about-us-{{ section.id }} .about-us-story {
      padding: 100px 0;
    }
  }
  #about-us-{{ section.id }} .about-us-story__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 48px;
  }
  @media (max-width: 768px) {
    #about-us-{{ section.id }} .about-us-story__container {
      padding: 0 24px;
    }
  }
  #about-us-{{ section.id }} .about-us-story__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
    align-items: start;
  }
  @media (max-width: 1024px) {
