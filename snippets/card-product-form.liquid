{% comment %}
  Single add-to-cart form for card-product. Preserves variant selection and AJAX cart.
  Accepts: product, current_variant, product_form_id, quick_add, hide_variant_selector (optional).
  When hide_variant_selector: true (e.g. bestsellers), no dropdown — uses first available variant only.
{% endcomment %}
{%- assign product_form_id = product_form_id | default: 'card-product-form' | append: product.id -%}
{%- assign hide_variant_selector = hide_variant_selector | default: false -%}
{%- assign form_class = 'card-product__form' -%}
{%- if hide_variant_selector -%}
  {%- assign form_class = form_class | append: ' card-product__form--bestsellers' -%}
{%- endif -%}
{%- form 'product', product, id: product_form_id, class: form_class, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
  <input type="hidden" name="quantity" value="1">
  {%- if product.has_only_default_variant or hide_variant_selector -%}
    <input type="hidden" name="id" value="{{ current_variant.id }}">
  {%- else -%}
    <label for="{{ product_form_id }}-variant" class="visually-hidden">{{ 'products.product.variant' | t }}</label>
    <select id="{{ product_form_id }}-variant" name="id" class="card-product__variant-select">
      {%- for variant in product.variants -%}
        <option value="{{ variant.id }}"{% if variant == current_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
          {{ variant.title }}{% unless variant.available %} - {{ 'products.product.sold_out' | t }}{% endunless %}
        </option>
      {%- endfor -%}
    </select>
  {%- endif -%}
  <button
    type="submit"
    name="add"
    class="card-product__button button button--full-width{% if hide_variant_selector %} card-product__button--bestsellers{% endif %}"
    {% unless current_variant.available %}disabled{% endunless %}
  >
    {%- if hide_variant_selector -%}
      <span class="card-product__button-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span>
    {%- endif -%}
    <span class="card-product__button-text">
      {%- if current_variant.available -%}
        {{ 'products.product.add_to_cart' | t }}
      {%- else -%}
        {{ 'products.product.sold_out' | t }}
      {%- endif -%}
    </span>
  </button>
{%- endform -%}
