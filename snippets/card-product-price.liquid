{% comment %}
  Price block for card-product. No duplicate logic.
  Accepts: product, current_variant.
{% endcomment %}
<div class="card-product__price">
  {%- if current_variant.compare_at_price > current_variant.price -%}
    <span class="card-product__price--sale">{{ current_variant.price | money }}</span>
    <span class="card-product__price--compare">{{ current_variant.compare_at_price | money }}</span>
  {%- else -%}
    {{ current_variant.price | money }}
  {%- endif -%}
</div>
