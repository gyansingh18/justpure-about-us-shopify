<script>
  (function() {
    const productPage = document.getElementById('product-{{ product.id }}');
    if (!productPage) return;

    // Image thumbnail switching
    const thumbnails = productPage.querySelectorAll('.custom-product-images__thumbnail');
    const mainImage = productPage.querySelector('.custom-product-images__main-img');
    const mainImageWrapper = productPage.querySelector('.custom-product-images__main-wrapper');

    thumbnails.forEach(thumbnail => {
      thumbnail.addEventListener('click', function() {
        const imageId = this.dataset.imageId;
        const thumbnailImg = this.querySelector('img');

        // Update active state
        thumbnails.forEach(t => t.classList.remove('active'));
        this.classList.add('active');

        // Update main image
        if (mainImage) {
          mainImage.src = thumbnailImg.src.replace('width=200', 'width=1200');
          mainImage.alt = thumbnailImg.alt;
        }
      });
    });

    // Variant selection
    const variantOptions = productPage.querySelectorAll('.custom-product-form__variant-option:not(.disabled)');
    const variantSelect = productPage.querySelector('#ProductSelect-{{ section.id }}');
    const priceElement = productPage.querySelector('#ProductPrice-{{ section.id }}');
    const comparePriceElement = productPage.querySelector('#ComparePrice-{{ section.id }}');

    variantOptions.forEach(option => {
      option.addEventListener('click', function() {
        const variantId = this.dataset.variantId;
        const variantPrice = this.dataset.variantPrice;
        const variantComparePrice = this.dataset.variantComparePrice;
        const variantImageId = this.dataset.variantImageId;

        // Update active state
        variantOptions.forEach(o => o.classList.remove('active'));
        this.classList.add('active');

        // Update select
        if (variantSelect) {
          variantSelect.value = variantId;
        }

        // Update price
        if (priceElement) {
          priceElement.textContent = variantPrice;
        }

        // Update compare price
        if (comparePriceElement && variantComparePrice) {
          comparePriceElement.textContent = variantComparePrice;
          comparePriceElement.parentElement.style.display = 'flex';
        } else if (comparePriceElement) {
          comparePriceElement.parentElement.style.display = 'none';
        }

        // Update image if variant has different image
        if (variantImageId && mainImage) {
          const variantImage = Array.from(productPage.querySelectorAll('.custom-product-images__thumbnail-img')).find(img => {
            return img.closest('.custom-product-images__thumbnail').dataset.imageId === variantImageId;
          });
          if (variantImage) {
            mainImage.src = variantImage.src.replace('width=200', 'width=1200');
            thumbnails.forEach(t => {
              if (t.dataset.imageId === variantImageId) {
                t.classList.add('active');
              } else {
                t.classList.remove('active');
              }
            });
          }
        }
      });
    });

    // Quantity controls
    const quantityInput = productPage.querySelector('.custom-product-form__quantity-input');
    const quantityDecrease = productPage.querySelector('[data-action="decrease"]');
    const quantityIncrease = productPage.querySelector('[data-action="increase"]');

    if (quantityDecrease) {
      quantityDecrease.addEventListener('click', function() {
        if (quantityInput && parseInt(quantityInput.value) > 1) {
          quantityInput.value = parseInt(quantityInput.value) - 1;
        }
      });
    }

    if (quantityIncrease) {
      quantityIncrease.addEventListener('click', function() {
        if (quantityInput) {
          quantityInput.value = parseInt(quantityInput.value) + 1;
        }
      });
    }

    // Image zoom
    const zoomButton = productPage.querySelector('.custom-product-images__zoom');
    const zoomModal = document.getElementById('product-zoom-modal');
    const zoomImage = document.getElementById('zoom-image');
    const zoomClose = zoomModal?.querySelector('.custom-product-zoom__close');

    if (zoomButton && zoomModal && zoomImage) {
      zoomButton.addEventListener('click', function() {
        if (mainImage) {
          zoomImage.src = mainImage.src.replace('width=1200', 'width=2000');
          zoomImage.alt = mainImage.alt;
          zoomModal.style.display = 'flex';
          document.body.style.overflow = 'hidden';
        }
      });
    }

    if (mainImageWrapper) {
      mainImageWrapper.addEventListener('click', function(e) {
        if (e.target === mainImage && zoomModal) {
          zoomImage.src = mainImage.src.replace('width=1200', 'width=2000');
          zoomImage.alt = mainImage.alt;
          zoomModal.style.display = 'flex';
          document.body.style.overflow = 'hidden';
        }
      });
    }

    if (zoomClose) {
      zoomClose.addEventListener('click', function() {
        zoomModal.style.display = 'none';
        document.body.style.overflow = '';
      });
    }

    if (zoomModal) {
      zoomModal.addEventListener('click', function(e) {
        if (e.target === zoomModal) {
          zoomModal.style.display = 'none';
          document.body.style.overflow = '';
        }
      });
    }

    // Tab switching
    const tabs = productPage.querySelectorAll('.custom-product-details__tab');
    const panels = productPage.querySelectorAll('.custom-product-details__panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', function() {
        const targetTab = this.dataset.tab;

        // Update active states
        tabs.forEach(t => t.classList.remove('active'));
        panels.forEach(p => p.classList.remove('active'));

        this.classList.add('active');
        const targetPanel = productPage.querySelector(`#tab-${targetTab}`);
        if (targetPanel) {
          targetPanel.classList.add('active');
        }
      });
    });

    // Form submission
    const productForm = productPage.querySelector('#ProductForm-{{ section.id }}');
    const submitButton = productPage.querySelector('#AddToCart-{{ section.id }}');

    if (productForm && submitButton) {
      productForm.addEventListener('submit', function(e) {
        e.preventDefault();

        const formData = new FormData(this);
        const submitText = submitButton.querySelector('.custom-product-form__submit-text');
        const submitLoader = submitButton.querySelector('.custom-product-form__submit-loader');

        // Show loading state
        submitButton.classList.add('loading');
        submitButton.disabled = true;

        fetch('/cart/add.js', {
          method: 'POST',
          body: formData
        })
        .then(response => response.json())
        .then(data => {
          // Trigger cart drawer update (if using Shopify's cart drawer)
          if (typeof window.theme !== 'undefined' && window.theme.cartDrawer) {
            window.theme.cartDrawer.open();
          } else {
            // Fallback: redirect to cart
            window.location.href = '/cart';
          }
        })
        .catch(error => {
          console.error('Error:', error);
          alert('There was an error adding the product to your cart. Please try again.');
        })
        .finally(() => {
          submitButton.classList.remove('loading');
          submitButton.disabled = false;
        });
      });
    }
  })();
</script>
